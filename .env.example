# Copy to .env.local and fill in. Never commit real values — .env* is gitignored.

# ---------------------------------------------------------------- database --
# Any PostgreSQL 13+ connection string (Neon, Supabase, Vercel Postgres, local).
#
# Supabase: dashboard -> Connect -> Connection string. Use the transaction
# pooler (port 6543) on serverless hosts and set DATABASE_POOL_MAX=1. The
# password here is the database password, not an API key. Run db:migrate after
# setting it: migration 002 keeps these tables off Supabase's public data API.
#
# For local development without any Postgres at all, use:
#   DATABASE_URL="pglite://./.pgdata"
DATABASE_URL="postgresql://user:password@host:5432/expense_tracker"

# ------------------------------------------------------------------- auth --
# Signs and encrypts the session cookie. Generate one with:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=""

# Absolute base URL, used for the links inside verification and reset emails.
# On Vercel this is detected automatically and can be left unset.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------ email --
# Optional. Verification and password reset messages go out over SMTP. Set all
# four and mail is sent; leave any of them blank and the app prints the links to
# the server console instead, which is enough for local development.
#
# Brevo: SMTP & API -> SMTP. The login looks like <id>@smtp-brevo.com and the
# password is the SMTP key (xsmtpsib-...), which is a credential — keep it in
# .env.local and in your host's environment settings, never in the repository.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# The sender must be an address the relay has verified, or it will reject the
# message. A display name is optional.
EMAIL_FROM="Expense Tracker <no-reply@example.com>"

# Optional. Connections per server instance (default 5). Lower it when a
# connection pooler sits in front of the database.
DATABASE_POOL_MAX="5"

# Optional. Milliseconds an idle connection is kept (default 10000). Use 0 on a
# long-lived server to keep connections open.
DATABASE_POOL_IDLE_MS="10000"
